PORT=5000
NODE_ENV=development

# Database: SQLite for local dev or Supabase PostgreSQL for cloud
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Supabase PostgreSQL example:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth & Storage (from your Supabase Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client URLs (for CORS)
CLIENT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
