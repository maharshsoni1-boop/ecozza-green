# Ecozza Green .env.example

# Database: SQLite for local or PostgreSQL for production (e.g. postgresql://user:password@localhost:5432/ecozza_green)
DATABASE_URL="file:./dev.db"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Ecozza Green"

# Razorpay India
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Resend Email
RESEND_API_KEY="re_your_resend_key"
CONTACT_SALES_EMAIL="sales@ecozzagreen.in"

# WhatsApp Business Direct Chat
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Admin Secret
ADMIN_SECRET_KEY="replace_with_a_long_random_secret_string"
NEXTAUTH_SECRET="replace_with_a_long_random_auth_secret"

# Shipping Provider (mock or shiprocket)
SHIPPING_PROVIDER="mock"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
